# PostgreSQL (required for Prisma unless DISABLE_PROGRESS_DB=1).
# Examples:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/aba"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Skip opening a DB connection (site runs; saves that need Prisma are skipped)
# DISABLE_PROGRESS_DB=1
