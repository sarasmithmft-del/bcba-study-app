# PostgreSQL (optional — Phase 1 progress DB is not required for the static study app).
# Examples:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/aba"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Skip opening a DB connection (site runs; saves that need Prisma are skipped)
# DISABLE_PROGRESS_DB=1

# Claude study assistant (/chat) — only used by `npm run dev` (API route).
# Not available inside the Capacitor / static-export iOS bundle.
# CLAUDE_API_KEY=sk-ant-...
